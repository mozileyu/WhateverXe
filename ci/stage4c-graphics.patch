+#!/usr/bin/env python3
+"""Portable tests of the actual Distribution generator; no simulated pkg tools."""
+import json
+import subprocess
+import unittest
+import xml.etree.ElementTree as ET
+from pathlib import Path
+from build import distribution_tree
+
+VERSION_CASES = {
+    '11.7.10': None, '11.7.11': 'Big Sur', '12.7.5': None, '12.7.6': 'Monterey',
+    '13.7.7': None, '13.7.8': 'Ventura', '14.8.8': None, '14.8.9': 'Sonoma',
+    '15.7.9': None, '15.8': 'Sequoia', '15.8.0': 'Sequoia', '15.8.99': 'Sequoia',
+    '15.9': None, '16.0': None, '26.0': None, '26.5.99': None, '26.6': 'Tahoe',
+    '26.6.0': 'Tahoe', '26.6.1': 'Tahoe', '26.6.2': 'Tahoe',
+    '26.6.99': 'Tahoe', '26.7': 'Tahoe',
+    '26.7.1': 'Tahoe', '26.7.2': 'Tahoe', '26.8': 'Tahoe', '26.99.99': 'Tahoe', '27.0': None,
+}
+
+class PolicyTests(unittest.TestCase):
+    @classmethod
+    def setUpClass(cls):
+        cls.policy = json.loads(Path(__file__).with_name('policy.json').read_text())
+        cls.names = ['Common'] + [s['payload'] for s in cls.policy['systems']]
+        cls.tree = ET.fromstring(ET.tostring(distribution_tree(cls.policy, cls.names)))
+
+    def test_numeric_boundaries_and_actual_choices(self):
+        choices = {x.attrib['title']: x.attrib['selected'] for x in self.tree.findall('choice')}
+        ranges = [x.attrib for x in self.tree.findall('./volume-check/allowed-os-versions/os-version')]
+        js = r"""const input=JSON.parse(process.argv[1]);
+const system={version:{},compareVersions(a,b){
+  a=a.split('.').map(Number); b=b.split('.').map(Number);
+  for(let i=0;i<Math.max(a.length,b.length);i++){
+    const d=(a[i]||0)-(b[i]||0); if(d)return Math.sign(d);
+  }return 0;
+}};
+for(const [version,expected] of Object.entries(input.cases)){
+ system.version.ProductVersion=version;
+ const actual=Object.entries(input.choices).filter(([id,expr])=>id!=='Common'&&eval(expr)).map(([id])=>id);
+ if(JSON.stringify(actual)!==JSON.stringify(expected?[expected]:[]))throw new Error(version);
+ const admitted=input.ranges.some(r=>system.compareVersions(version,r.min)>=0&&system.compareVersions(version,r.before)<0);
+ if(admitted!==Boolean(expected))throw new Error('volume-check '+version);
+}
+console.log('PASS: '+Object.keys(input.cases).length+' actual choice and volume-check boundaries');"""
+        subprocess.run(['node', '-e', js, json.dumps({'choices': choices, 'ranges': ranges, 'cases': VERSION_CASES})], check=True)
+
+    def test_older_system_policy_unchanged(self):
+        expected = [('11.7.11', '12'), ('12.7.6', '13'), ('13.7.8', '14'), ('14.8.9', '15'), ('15.8', '15.9')]
+        self.assertEqual([(s['minimum'],s['before']) for s in self.policy['systems'][:-1]], expected)
+
+    def test_tahoe_range(self):
+        self.assertEqual((self.policy['systems'][-1]['minimum'], self.policy['systems'][-1]['before']), ('26.6','27'))
+
+    def test_payload_provenance_is_not_relabelled(self):
+        self.assertEqual(self.policy['systems'][-1]['source_build'], '25G241')
+
+    def test_common_and_component_versions(self):
+        self.assertEqual(self.tree.find("choice[@id='Common']").attrib['selected'], 'true')
+        for ref in self.tree.findall('pkg-ref'):
+            self.assertEqual(ref.attrib['version'], self.policy['package_version'])
+
+    def test_intel_and_system_volume_only(self):
+        self.assertEqual(self.tree.find('options').attrib['hostArchitectures'], 'x86_64')
+        self.assertEqual(self.tree.find('domains').attrib, {'enable_anywhere':'false','enable_currentUserHome':'false','enable_localSystem':'true'})
+
+if __name__ == '__main__':
+    unittest.main()
