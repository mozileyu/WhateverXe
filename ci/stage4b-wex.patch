diff --git a/WhateverXe/kern_xelp_os.hpp b/WhateverXe/kern_xelp_os.hpp
index ad85a66..3328bfa 100644
--- a/WhateverXe/kern_xelp_os.hpp
+++ b/WhateverXe/kern_xelp_os.hpp
@@ -23,7 +23,8 @@ inline OS kernelOS(const char *version) {
     }
     // Servicing updates must not silently bypass ABI setup because the build
     // date/XNU revision changed. Darwin 24.6 cannot distinguish macOS 15.7
-    // from 15.8: the package enforces 15.8.x. Darwin 25.6+ covers 26.7+.
+    // from 15.8: the package enforces 15.8.x. Darwin 25.6+ also identifies Tahoe 26.6.x; it does not
+    // distinguish the product-version floor enforced by the installer policy.
     const char *p=version,*prefix="Darwin Kernel Version ";
     while (*prefix && *p==*prefix) {++p;++prefix;}
     if (*prefix) return OS::Unknown;
