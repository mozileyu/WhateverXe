diff --git a/tests/tahoe_pmap_call.cpp b/tests/tahoe_pmap_call.cpp
new file mode 100644
--- /dev/null
+++ b/tests/tahoe_pmap_call.cpp
@@ -0,0 +1,36 @@
+// Synthetic only: no real CPU kernel, PCI or GPU interfaces.
+#include "kern_tahoe_pmap_call.hpp"
+#include <assert.h>
+#include <stdio.h>
+int main() {
+ using V=XELP::TahoeProtectCall;
+ uint8_t oldCall[]={0xE8,0x2F,0xF3,0x02,0x00},newCall[]={0xE8,0xDF,0xF1,0x02,0x00};
+ unsigned cases=0;
+ auto check=[&](const uint8_t *b,size_t n,uintptr_t site,uintptr_t target,V expected) {
+  assert(XELP::qualifyTahoeProtectCall(b,n,site,target)==expected);++cases;
+ };
+ const uintptr_t site=0x100000;
+ check(oldCall,5,site,site+5+0x2F32F,V::Source25G241);
+ check(newCall,5,site,site+5+0x2F1DF,V::Target25G83);
+ check(oldCall,5,site,site+5+0x2F32F+1,V::Unknown);
+ check(newCall,5,site,site+5+0x2F1DF-1,V::Unknown);
+ check(nullptr,5,site,site+5+0x2F1DF,V::Unknown);
+ check(newCall,0,site,site+5+0x2F1DF,V::Unknown);
+ check(newCall,4,site,site+5+0x2F1DF,V::Unknown);
+ check(newCall,6,site,site+5+0x2F1DF,V::Unknown);
+ uint8_t wrongOpcode[]={0xE9,0xDF,0xF1,0x02,0};
+ check(wrongOpcode,5,site,site+5+0x2F1DF,V::Unknown);
+ uint8_t unknownDisplacement[]={0xE8,0xE0,0xF1,0x02,0};
+ check(unknownDisplacement,5,site,site+5+0x2F1E0,V::Unknown);
+ uint8_t negative[]={0xE8,0xFB,0xFF,0xFF,0xFF};
+ check(negative,5,site,site,V::Unknown);
+ check(newCall,5,UINTPTR_MAX-3,0x123,V::Unknown);
+ check(newCall,5,UINTPTR_MAX-5,0x2F1DE,V::Unknown);
+ check(newCall,5,0,5+0x2F1DF,V::Unknown);
+ check(newCall,5,site,0,V::Unknown);
+ // Actual immutable-file addresses are merely Synthetic integers here.
+ check(newCall,5,0xffffff8000482c6cULL,0xffffff80004b1e50ULL,V::Target25G83);
+ check(oldCall,5,0xffffff800039acccULL,0xffffff80003ca000ULL,V::Source25G241);
+ check(newCall,5,0xffffff8000482c6cULL,0xffffff80003ca000ULL,V::Unknown);
+ printf("PASS: %u Synthetic protect-call cases; no hardware validation\n",cases);
+}
