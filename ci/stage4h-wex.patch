diff --git a/WhateverXe/kern_tahoe_pmap_call.hpp b/WhateverXe/kern_tahoe_pmap_call.hpp
new file mode 100644
--- /dev/null
+++ b/WhateverXe/kern_tahoe_pmap_call.hpp
@@ -0,0 +1,21 @@
+// Exact known Tahoe protect-call variants; no MMIO or instruction writes.
+#ifndef KERN_TAHOE_PMAP_CALL_HPP
+#define KERN_TAHOE_PMAP_CALL_HPP
+#include <stdint.h>
+#include <stddef.h>
+namespace XELP {
+enum class TahoeProtectCall : uint32_t { Unknown=0, Source25G241=1, Target25G83=2 };
+inline TahoeProtectCall qualifyTahoeProtectCall(const uint8_t *call,size_t length,
+                                               uintptr_t site,uintptr_t target) {
+    if(!call || length!=5 || !site || !target || call[0]!=0xE8)return TahoeProtectCall::Unknown;
+    const uint32_t displacement=uint32_t(call[1]) | uint32_t(call[2])<<8 |
+        uint32_t(call[3])<<16 | uint32_t(call[4])<<24;
+    // Both audited relative displacements are positive. Unknown/negative calls
+    // are rejected even if they happen to resolve to the supplied destination.
+    if(displacement!=0x2F32F && displacement!=0x2F1DF)return TahoeProtectCall::Unknown;
+    if(site>UINTPTR_MAX-5 || site+5>UINTPTR_MAX-displacement || site+5+displacement!=target)
+        return TahoeProtectCall::Unknown;
+    return displacement==0x2F32F ? TahoeProtectCall::Source25G241 : TahoeProtectCall::Target25G83;
+}
+}
+#endif
