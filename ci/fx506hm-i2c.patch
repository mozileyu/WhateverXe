--- a/VoodooI2C/VoodooI2C/VoodooI2CDevice/VoodooI2CDeviceNub.cpp
+++ b/VoodooI2C/VoodooI2C/VoodooI2CDevice/VoodooI2CDeviceNub.cpp
@@ -224,6 +224,23 @@
     setProperty("i2cAddress", i2c_address, 16);
 
     setProperty("sclHz", resource_parser.i2c_info.bus_speed, 32);
+
+    // FX506HM 2.9.1d1 diagnostic: opt-in exact physical controller + TPD0 only.
+    // Resource parsing, resource qualification and address selection above stay intact.
+    auto targetPCI = controller->nub->controller->physical_device.pci_device;
+    auto pollingData = targetPCI ? OSDynamicCast(OSData, targetPCI->getProperty("force-polling")) : nullptr;
+    if (targetPCI && pollingData && pollingData->getLength() == 1 &&
+        *static_cast<const UInt8*>(pollingData->getBytesNoCopy()) == 1 &&
+        targetPCI->getBusNumber() == 0 && targetPCI->getDeviceNumber() == 0x15 &&
+        targetPCI->getFunctionNumber() == 0 &&
+        targetPCI->configRead16(0x00) == 0x8086 && targetPCI->configRead16(0x02) == 0x43e8 &&
+        targetPCI->configRead8(0x08) == 0x11 &&
+        targetPCI->configRead16(0x2c) == 0x1043 && targetPCI->configRead16(0x2e) == 0x16f2 &&
+        !strcmp(acpi_device->getName(), "TPD0")) {
+        IOLog("%s::%s FX506HM 2.9.1d1: qualified resources; prefer polling before APIC\n",
+              getName(), acpi_device->getName());
+        return kIOReturnSuccess;
+    }
 
     // There is actually no way to avoid APIC interrupt if it is valid
     if (validateAPICInterrupt() == kIOReturnSuccess)
